# Required for current runtime Gemini calls
GEMINI_API_KEY=

# Optional runtime model override used by execution infrastructure
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional alternative recognized by google-genai SDK
# GOOGLE_API_KEY=

# Cloud Run injects PORT automatically (default is typically 8080).
# Set this only for local/container overrides.
# PORT=8080